# =============================================================================
# GitLab Infrastructure - Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to version control - it contains secrets
#
# Usage:
#   cp terraform.tfvars.template terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform init
#   terraform plan
#   terraform apply

# =============================================================================
# Required: Hetzner Cloud API Token
# =============================================================================
# Get this from: https://console.hetzner.cloud/
#   Project -> Security -> API Tokens -> Generate API Token
# Required permissions: Read & Write

hcloud_token = "your-hetzner-cloud-api-token-here"

# =============================================================================
# Required: Domain Configuration
# =============================================================================
# The domain where GitLab will be accessible
# After deployment, configure DNS to point this domain to the load balancer IP
# (The load balancer IP is shown in terraform output)

domain      = "gitlab.yourcompany.com"
admin_email = "admin@yourcompany.com"

# =============================================================================
# Required: GitLab CE Version
# =============================================================================
# Pin to a specific apt package version. Browse versions at:
#   https://packages.gitlab.com/gitlab/gitlab-ce
# Update deliberately after reading release notes; see docs/DESIGN.md §5.6.

gitlab_version = "17.10.0-ce.0"

# =============================================================================
# Required: SSH Access Configuration
# =============================================================================
# SSH public keys for admin access to servers
# Format: map of name => public key content
# Generate with: ssh-keygen -t ed25519 -C "your@email.com"

ssh_public_keys = {
  "admin-alice" = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... alice@example.com"
  "admin-bob"   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... bob@example.com"
}

# IP addresses allowed to SSH to the GitLab server (CIDR notation).
# REQUIRED — must contain at least one valid CIDR. `terraform plan` will
# fail if this is missing or empty; there is NO fallback to 0.0.0.0/0.
# (security review T1.4, 2026-05-15)
#
# Tip: list every operator's home / office / VPN egress separately so you
# can revoke individuals without flushing the whole allowlist.

trusted_ssh_ips = [
  "203.0.113.10/32",   # Example: Office IP
  "198.51.100.0/24",   # Example: VPN range
]

# =============================================================================
# Required: Storage Box (Borg backup destination)
# =============================================================================
# Storage Boxes are now provisioned via the Hetzner Cloud Console (and this
# Terraform code) as of provider v1.63.0 (May 2026). The previous Hetzner
# Robot account is no longer required. See docs/DEPLOY.md §1.
#
# The Storage Box and its append-only sub-account are managed by
# terraform/storage_box.tf with `prevent_destroy = true` — accidentally
# `terraform destroy`-ing them is blocked. Removing that guard requires a
# deliberate code-review change.

storage_box_name     = "acme-gitlab-backups"
storage_box_type     = "bx21"   # 5TB; bump to bx31/bx41 for larger projects
storage_box_location = "fsn1"   # same region as the server; Hetzner picks a different DC

# Primary Storage Box password. Used for emergency Hetzner Console access
# only — day-to-day Borg backups use the SSH key below. Generate with:
#   openssl rand -base64 24
# Store in offline recovery kit AND in seed.yaml (encrypted).
storage_box_password = "GENERATE-32-CHAR-RANDOM-PER-DEPLOY.md-2a"

# OPERATOR'S OFFLINE full-access SSH public key. The PRIVATE half MUST
# live only in the offline recovery kit and MUST NEVER be copied to the
# GitLab server (DEPLOY.md §2a). Generate the keypair on an offline
# workstation; paste the .pub line here.
storage_box_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... recovery@offline-laptop"

# Password for the append-only sub-account. Used once, by
# scripts/setup-borg-append-only.sh, to SFTP in and install the
# forced-command authorized_keys file. Borg uses SSH keys after that.
# Generate with: openssl rand -base64 24
storage_box_subaccount_password = "GENERATE-32-CHAR-RANDOM-PER-DEPLOY.md-6"

# =============================================================================
# Server Configuration
# =============================================================================
# Server type - adjust based on team size and workload
#
# GitLab server options:
#   cx31:  2 vCPU,  8 GB RAM (~8 EUR/mo)  - Small teams (5-10 devs)
#   cpx31: 4 vCPU, 16 GB RAM (~18 EUR/mo) - Medium teams (10-25 devs) [RECOMMENDED]
#   cpx41: 8 vCPU, 32 GB RAM (~35 EUR/mo) - Large teams (25-50 devs)
#   cpx51: 16 vCPU, 64 GB RAM (~70 EUR/mo) - Enterprise (50+ devs)
#
# Prometheus, Grafana, Alertmanager, and the backup cron jobs run on the same
# server alongside GitLab; no separate automation host is provisioned.

gitlab_server_type = "cpx31"

# OS image (Ubuntu 24.04 LTS recommended for long-term support)
server_image = "ubuntu-24.04"

# Datacenter location
#   fsn1 = Falkenstein, Germany (recommended - best network)
#   nbg1 = Nuremberg, Germany
#   hel1 = Helsinki, Finland
location = "fsn1"

# =============================================================================
# Storage Configuration
# =============================================================================
# Volume sizes in GB
# GitLab data: stores repositories, uploads, container registry, etc.
# Backup staging: temporary storage before sending to Borg (needs space for 1 full backup)

gitlab_data_volume_size   = 200  # Increase based on expected repository sizes
gitlab_backup_volume_size = 100  # Should be >= largest expected backup

# =============================================================================
# Network Configuration (Advanced)
# =============================================================================
# Usually no changes needed - defaults work for most deployments

# Private network CIDR
network_cidr = "10.0.0.0/16"

# Subnet CIDR
subnet_cidr = "10.0.1.0/24"

# Server private IP (within subnet)
gitlab_private_ip = "10.0.1.10"

# =============================================================================
# Resource Labels
# =============================================================================
# Labels applied to all Hetzner resources for organization and billing

common_labels = {
  project    = "acme-gitlab"
  managed_by = "terraform"
  env        = "prod"
}

# Environment name
environment = "prod"
