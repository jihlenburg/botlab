[Unit]
Description=Hourly GitLab backup
Documentation=file:///opt/botlab/systemd/README.md

[Timer]
# Hourly on the hour, jittered up to 5 min to spread load if you ever
# fan this out across multiple instances.
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
