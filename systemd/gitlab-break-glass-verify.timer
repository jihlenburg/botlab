[Unit]
Description=Monthly break-glass admin verification
Documentation=file:///opt/botlab/systemd/README.md

[Timer]
# Monthly, on the 1st at 09:00 — during business hours so a failure
# is noticed and acted on the same day.
OnCalendar=*-*-01 09:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
