[Unit]
Description=Weekly automated GitLab restore test
Documentation=file:///opt/botlab/systemd/README.md

[Timer]
# Sundays at 02:00 local — quiet hours, BEFORE the integrity check
# (so an integrity failure doesn't block the restore test).
OnCalendar=Sun *-*-* 02:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
